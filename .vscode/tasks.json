{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Docker Containers",
            "type": "shell",
            "command": "docker compose -f Backend/docker-compose.yml up --no-recreate -d",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "source .env variables",
            "type": "shell",
            "command": "export $(cat .env | xargs)",
            "options": {
                "shell": {
                    "executable": "/bin/bash",
                    "args": ["-c"]
                }
            },
            "problemMatcher": []
        }
    ]
}